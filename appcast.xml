      <sparkle:shortVersionString>0.9.16</sparkle:shortVersionString>
      <sparkle:minimumSystemVersion>13.0</sparkle:minimumSystemVersion>
      <description><![CDATA[<ul><li>Reduced rendering work and memory use when editing photos at fit-to-window size.</li><li>Edited thumbnails now render at thumbnail size; exports and full-resolution zoom keep full detail.</li></ul>]]></description>
      <enclosure url="https://rawdemption.com/downloads/RAWdemption-0.9.16.zip" length="2591720" type="application/octet-stream" sparkle:edSignature="oAc8O+JPZDYDX3florQ093yX5SAxxUAXwuHqB8ZTzl9CGSytk45Y9CFEKWEa7VkA1jBXkhHNTLE/642zPrTrBw=="/>
